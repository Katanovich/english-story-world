# Copy to .env and fill in values. Never commit .env.

# --- Environment ---
# development | production
APP_ENV=development

# --- PostgreSQL ---
POSTGRES_USER=esw
POSTGRES_PASSWORD=change-me
POSTGRES_DB=english_story_world
# Host port for the PostgreSQL container (5434 avoids clashing with a local install)
POSTGRES_HOST_PORT=5434

# Used by the backend. Inside Docker Compose the host is "db" and port 5432.
DATABASE_URL=postgresql+psycopg://esw:change-me@localhost:5434/english_story_world
# Separate database used by pytest (created automatically by the test suite)
TEST_DATABASE_URL=postgresql+psycopg://esw:change-me@localhost:5434/english_story_world_test

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
SESSION_TTL_HOURS=72
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# --- Initial administrator (used by the bootstrap command; no defaults) ---
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Load the "Little Explorers" A1 lessons when the backend container starts (safe to rerun).
SEED_ON_START=true

# --- Media storage ---
# local | s3 (s3 is not implemented yet; see README)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./media_storage
MAX_IMAGE_MB=5
MAX_AUDIO_MB=20
MAX_VIDEO_MB=500

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
